function(rapid_linux_sdk_validate ROOT RESULT MISSING)
  set(REQUIRED_LIBRARIES libRapidCore.so libRapidMedia.so libRapidSDL.so libwebrtc.so)
  set(MISSING_FILES "")

  foreach(REQUIRED_LIBRARY IN LISTS REQUIRED_LIBRARIES)
    if(EXISTS "${ROOT}/libraries/${REQUIRED_LIBRARY}")
      continue()
    endif()

    if(REQUIRED_LIBRARY STREQUAL "libRapidCore.so" OR REQUIRED_LIBRARY STREQUAL "libwebrtc.so")
      set(MODULE core)
    elseif(REQUIRED_LIBRARY STREQUAL "libRapidMedia.so")
      set(MODULE media)
    else()
      set(MODULE sdl)
    endif()

    if(NOT EXISTS "${ROOT}/${MODULE}/lib/${REQUIRED_LIBRARY}")
      list(APPEND MISSING_FILES "${REQUIRED_LIBRARY}")
    endif()
  endforeach()

  if(MISSING_FILES)
    set(${RESULT} FALSE PARENT_SCOPE)
  else()
    set(${RESULT} TRUE PARENT_SCOPE)
  endif()
  set(${MISSING} "${MISSING_FILES}" PARENT_SCOPE)
endfunction()
