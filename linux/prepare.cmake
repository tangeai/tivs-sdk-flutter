set(RAPID_LINUX_SDK_ROOT "${CMAKE_CURRENT_LIST_DIR}/native/${RAPID_LINUX_ARCH}")
include("${CMAKE_CURRENT_LIST_DIR}/validate.cmake")
rapid_linux_sdk_validate("${RAPID_LINUX_SDK_ROOT}" SDK_COMPLETE MISSING_FILES)
if(NOT SDK_COMPLETE)
  message(FATAL_ERROR "Bundled Linux SDK is incomplete: ${MISSING_FILES}")
endif()
set(RAPID_CORE_LIBRARY "${RAPID_LINUX_SDK_ROOT}/libraries/libRapidCore.so")
set(RAPID_MEDIA_LIBRARY "${RAPID_LINUX_SDK_ROOT}/libraries/libRapidMedia.so")
set(RAPID_SDL_LIBRARY "${RAPID_LINUX_SDK_ROOT}/libraries/libRapidSDL.so")
set(RAPID_WEBRTC_LIBRARY "${RAPID_LINUX_SDK_ROOT}/libraries/libwebrtc.so")
